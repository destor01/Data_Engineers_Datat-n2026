# Copia este archivo como .env en la raíz para correr la API unificada en local:
#   uvicorn api.index:app --port 8000 --reload
# En Vercel estas variables se definen en Settings → Environment Variables (ver documentation/deployment.md).
# No subas el archivo .env al repositorio.

# --- Supabase -----------------------------------------------------------------
# Sin estas variables: no se pide login, la API solo atiende localhost y Data Audit guarda en disco.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audio-interviews
QA_STORAGE_BUCKET=qa-cargas

# PostgreSQL. En Vercel: cadena "Transaction pooler" (puerto 6543).
DATABASE_URL=

# --- Audio Audit ----------------------------------------------------------------
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=

# --- Data Audit -----------------------------------------------------------------
# anthropic | ollama | ninguno (por defecto anthropic si hay ANTHROPIC_API_KEY)
QA_IA_PROVEEDOR=
ANTHROPIC_API_KEY=
# Tamaño máximo de una base en MB (Supabase gratis: 50)
QA_MAX_MB=50

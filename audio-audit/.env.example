# Token de lectura de Hugging Face (necesario para descargar el modelo local de Pyannote).
# 1. Acepta los términos gratuitos en:
#    https://huggingface.co/pyannote/speaker-diarization-community-1
# 2. Crea un token de lectura en:
#    https://huggingface.co/settings/tokens
HF_TOKEN=

# Clave de OpenRouter para evaluar entrevistas con el modelo JEV (typesafe/jev-1.14).
# Obtén una clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo JEV a utilizar en OpenRouter Decisions API
JEV_MODEL=typesafe/jev-1.14

# Modelo Whisper por defecto (large-v3-turbo es ideal para español en 6 GB VRAM)
WHISPER_MODEL=large-v3-turbo

# Tipo de cómputo en GPU: int8 (recomendado para 6 GB VRAM), float16 o int8_float16
WHISPER_COMPUTE_TYPE=int8

# Tamaño de lote (reducir a 4 si falta memoria GPU)
WHISPER_BATCH_SIZE=8

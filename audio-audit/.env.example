# =====================================================================
# Despliegue MVP en Vercel + Supabase (y ejecución local)
# =====================================================================

# 1. Supabase (Base de datos PostgreSQL + Storage para audios largos sin límite de 4.5 MB)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audio-interviews

# 2. Evaluación JEV en OpenRouter (modelo typesafe/jev-1.14, ~$0.0004–$0.002 por entrevista)
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# 3. Voz a texto con separación de hablantes en la nube (NO requieren HF_TOKEN ni GPU; ideales para Vercel)
# Opción recomendada A: AssemblyAI Universal-2 (~$0.17 USD/hora con diarización incluida, $50 USD gratis)
ASSEMBLYAI_API_KEY=
# Opción recomendada B: Deepgram Nova-3 ($200 USD en créditos gratis, respuesta ultrarrápida)
DEEPGRAM_API_KEY=

# 4. Opcional (solo si usas WhisperX + Pyannote 100 % local en tu propia GPU)
HF_TOKEN=
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=8

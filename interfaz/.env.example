# Copia como interfaz/.env.local para desarrollo. En Vercel estas variables se definen en el proyecto.
# demo: datos de ejemplo sin backend · api: usa la API unificada (/api/*)
VITE_APP_MODE=api
# Supabase Auth (Project Settings → API). La llave publishable/anon es pública por diseño.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Límites en MB que muestra y valida la interfaz (Supabase gratis: 50 MB por archivo).
VITE_MAX_AUDIO_MB=50
VITE_MAX_DATA_MB=50
# Solo desarrollo: dónde corre la API unificada.
API_BACKEND_URL=http://127.0.0.1:8000

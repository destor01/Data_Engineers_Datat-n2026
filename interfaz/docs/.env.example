# demo permite probar todas las pantallas sin los motores.
# api utiliza exclusivamente los servicios configurados (no simula resultados).
VITE_APP_MODE=demo

# Direcciones de los backend. Las API deben permitir el origen de la interfaz por CORS.
VITE_AUDIO_API_URL=http://127.0.0.1:8000
VITE_DATA_API_URL=http://127.0.0.1:8001

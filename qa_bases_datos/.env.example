# Copia este archivo como .env (no se sube al repositorio)
DATABASE_URL=postgresql://postgres:tu_clave@localhost:5432/quality_audit
# Carpeta de archivos de las cargas (por defecto qa_bases_datos/almacen)
QA_ALMACEN=
# Orígenes permitidos para el front, separados por coma
QA_CORS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://localhost:3000

# ---- Codificador con IA ----
# anthropic (Claude, necesita ANTHROPIC_API_KEY) | ollama (modelo local) | ninguno (solo similitud de texto)
QA_IA_PROVEEDOR=anthropic
ANTHROPIC_API_KEY=
QA_IA_MODELO=claude-haiku-5-5
# Catálogos que se mandan a la IA (QUIEN_CERTIFICA no va: trae nombres de médicos)
QA_IA_CATALOGOS=PNC_CAUSA,CIE10,DEF_SITIO,OCUPACION_CIUO08
QA_IA_LOTE=40
QA_IA_PARALELO=4
# Solo si QA_IA_PROVEEDOR=ollama
OLLAMA_URL=http://localhost:11434
